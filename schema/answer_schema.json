{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosis answer (what the model under test must return)",
  "type": "object",
  "required": ["verdict", "cause", "fix", "rationale"],
  "properties": {
    "verdict": {"type": "string", "description": "one key of codes.json 'verdicts'"},
    "cause": {"type": "string", "description": "one 'code' from codes.json"},
    "fix": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"type": "string", "description": "one key of codes.json 'fix_actions'"},
        "target": {"type": ["string", "null"]},
        "value": {"type": ["string", "number", "boolean", "null"]}
      }
    },
    "rationale": {"type": "string", "description": "the evidence that decided it, in a few sentences"}
  }
}
