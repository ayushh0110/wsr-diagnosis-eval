# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Optional: another OpenAI-compatible endpoint
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: Kiro API key (ksk_...) for kiro/<model> entries in models.txt; needs kiro-cli on PATH
KIRO_API_KEY=
# Optional: Google AI Studio key for gemini/<model> entries (free tier covers Flash models)
GEMINI_API_KEY=
